{
  "name": "shydesk",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage.enabled",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "wdio run wdio.conf.ts; status=$?; node scripts/e2e-totals.ts .e2e-runs && exit $status",
    "test:e2e:device": "wdio run wdio.conf.ts; status=$?; node scripts/e2e-totals.ts .e2e-runs && exit $status"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "@wdio/cli": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "@wdio/types": "10.1.0",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "swagger-ui-dist": "5.34.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "webdriverio": "10.1.0",
    "wrangler": "4.157.0",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "edgedriver": false,
    "esbuild": false,
    "fsevents": false,
    "geckodriver": false,
    "workerd": false
  },
  "overrides": {
    "encoding-sniffer": "1.0.2",
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "undici": "7.30.1"
  },
  "dependencies": {
    "hono": "4.13.17",
    "jose": "6.2.15",
    "mediabunny": "1.65.2"
  }
}
