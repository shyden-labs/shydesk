{
  "name": "shydesk",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage.enabled",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "allowScripts": {
    "fsevents": false,
    "esbuild": false,
    "workerd": false
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "dependencies": {
    "hono": "4.13.13"
  }
}
